      "fields": [
        {
          "component": "tab",
          "name": "contentTab",
          "label": "Content"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title",
          "description": "e.g. Explore the Agentic bank"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "description",
          "label": "Description"
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "showResultCount",
          "label": "Show result count",
          "value": false
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "layout",
          "label": "Default layout",
          "value": "masonry",
          "options": [
            {
              "name": "Masonry",
              "value": "masonry"
            },
            {
              "name": "Grid",
              "value": "grid"
            },
            {
              "name": "List",
              "value": "list"
            }
          ]
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "cardsPerPage",
          "label": "Cards per page",
          "description": "Cards shown first; Load more shows the next ones.",
          "value": 9,
          "min": 1,
          "max": 48
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "loadMoreCount",
          "label": "Load more count",
          "description": "Cards added by each Load more.",
          "value": 6,
          "min": 1,
          "max": 48
        },
        {
          "component": "tab",
          "name": "sourceTab",
