              "name": "Default",
              "value": "default"
            },
            {
              "name": "Compact",
              "value": "compact"
            },
            {
              "name": "Featured",
              "value": "featured"
            },
            {
              "name": "Mixed",
              "value": "mixed"
            }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "enableFeatured",
          "label": "Enable featured cards",
          "description": "Large cards, one after each page of cards.",
          "value": true
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "featuredRule",
          "label": "Featured rule",
          "value": "featured",
          "options": [
            {
              "name": "featured=true",
              "value": "featured"
            },
            {
              "name": "priority<=3",
              "value": "priority"
            },
            {
              "name": "Manual",
              "value": "manual"
            }
          ],
          "condition": {
            "===": [
              {
                "var": "enableFeatured"
              },
              true
            ]
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "featuredPages",
          "label": "Featured pages",
          "multi": true,
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "enableFeatured"
                  },
                  true
                ]
              },
              {
                "===": [
                  {
                    "var": "featuredRule"
                  },
                  "manual"
                ]
              }
            ]
          }
        },
