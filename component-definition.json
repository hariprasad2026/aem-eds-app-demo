        {
          "title": "Search",
          "id": "search",
          "plugins": {
            "da": {
              "rows": 2,
              "columns": 1,
              "fields": [
                {
                  "name": "index",
                  "selector": "div:nth-child(1)>div"
                },
                {
                  "name": "classes",
                  "selector": "div:nth-child(2)>div>ul"
                }
              ]
            },
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Search",
                  "model": "search",
                  "filter": "search",
                  "index": "/query-index.json",
                  "classes": [
                    "minimal",
                    "full-width"
                  ]
                }
              }
            }
          }
        },
        {
          "title": "Spotlight",
