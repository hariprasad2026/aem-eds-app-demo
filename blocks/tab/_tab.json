{
  "definitions": [
    {
      "title": "Tab",
      "id": "tab",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Tab",
              "model": "tab",
              "key-value": true,
              "title": "Tab"
            }
          }
        }
      }
    }
