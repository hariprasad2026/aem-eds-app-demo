    "scroll": [
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "scrollSnap",
        "label": "Scroll snap",
        "value": true
      },
      {
        "component": "select",
        "valueType": "string",
        "name": "snapAlign",
        "label": "Snap alignment",
        "value": "start",
        "options": [
          {
            "name": "Start",
            "value": "start"
          },
          {
            "name": "Center",
            "value": "center"
          }
        ],
        "condition": {
          "===": [
            {
              "var": "scrollSnap"
            },
            true
          ]
        }
      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "hideScrollbar",
        "label": "Hide native scrollbar",
        "value": true
      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "mouseDrag",
        "label": "Allow mouse drag",
        "value": true
      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "touchSwipe",
        "label": "Allow touch swipe",
        "value": true
      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "keyboardScrolling",
        "label": "Keyboard scrolling",
        "value": true,
        "description": "Arrow keys, Home and End when the list has focus."
      },
      {
        "component": "select",
        "valueType": "string",
        "name": "scrollStep",
        "label": "Scroll step",
        "value": "one-card",
        "options": [
          {
            "name": "One card",
            "value": "one-card"
          },
          {
            "name": "Viewport",
            "value": "viewport"
          }
        ]
      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "loop",
        "label": "Loop",
        "value": false,
        "description": "Next at the end goes back to the start."
