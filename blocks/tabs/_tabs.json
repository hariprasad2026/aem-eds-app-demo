{
  "definitions": [
    {
      "title": "Tabs Container",
      "id": "tabs",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "name": "Tabs",
              "model": "tabs",
              "filter": "tabs",
              "style": "tabs-section",
              "tabsStyle": "underline",
              "tabsAlignment": "left",
              "tabsOrientation": "horizontal"
            }
          }
        }
      }
    },
    {
      "title": "Tabs",
      "id": "tabs-block",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Tabs",
              "model": "tabs-block",
              "filter": "tabs-block",
              "key-value": true,
              "tabsStyle": "underline",
              "tabsAlignment": "left",
              "tabsOrientation": "horizontal"
            }
          }
        }
      }
    },
    {
      "title": "Tab",
      "id": "tabs-item",
