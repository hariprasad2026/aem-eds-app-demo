{
  "definitions": [
    {
      "title": "Cards",
      "id": "cards",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Cards",
              "model": "cards",
              "filter": "cards",
              "key-value": true,
              "titleType": "h2",
              "displayAsTeaser": true,
              "cardStyle": "image",
              "imageRatio": "16-9",
              "panelHeight": "portrait",
              "linkItems": true,
              "showImage": true,
              "showEyebrow": true,
              "showTags": true,
              "showDescription": true,
              "showDate": true,
              "dateFormat": "dd-mmm-yy",
              "showCta": true,
              "imageLoading": "lazy",
              "desktopMode": "grid",
              "desktopColumns": 4,
              "tabletMode": "grid",
              "tabletColumns": 4,
              "mobileMode": "grid",
              "mobileColumns": 1,
              "scrollSnap": true,
              "emptyBehavior": "hide",
              "analyticsEnabled": true
            }
          }
        }
      }
    },
    {
      "title": "Card",
      "id": "card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Card",
              "model": "card"
            }
          }
        }
      }
    }
  ],
