          "label": "Date",
          "description": "Shown in the Date format of the block."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "contentLabel",
          "label": "Content type",
          "description": "e.g. Article or Report (report cards in the Mixed style)."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "readingTime",
          "label": "Reading time",
          "description": "Minutes, e.g. 6 (shown as 6m)."
        },
        {
          "component": "tab",
          "name": "linkTab",
          "label": "Link"
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "link",
          "label": "Link",
          "description": "A page of the site or https://…; empty: the card isn't linked."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "linkText",
          "label": "Link text",
          "description": "The title when the card has none."
        },
