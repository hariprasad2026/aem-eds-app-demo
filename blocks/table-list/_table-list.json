{
  "definitions": [
    {
      "title": "Table List",
      "id": "table-list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Table List",
              "model": "table-list",
              "filter": "table-list",
              "key-value": true,
              "variations": "industries",
              "listHeadingType": "h2",
              "maxCards": 4,
              "ctaStyle": "",
              "numbers": "",
              "itemAction": "",
              "itemButtonLabel": "Explore",
              "motion": "none"
            }
          }
        }
      }
    },
    {
      "title": "Table List Header",
      "id": "table-list-header",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Table List Header",
              "model": "table-list-header"
            }
          }
        }
      }
    },
    {
      "title": "Table List Item",
      "id": "table-list-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Table List Item",
              "model": "table-list-card",
              "title": "TwinX",
              "description": "<p>Risk free business experimentation and decision intelligence</p>"
            }
          }
        }
      }
    }
