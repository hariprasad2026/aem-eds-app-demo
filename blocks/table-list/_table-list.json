          "component": "text",
          "valueType": "string",
          "name": "itemButtonLabel",
          "label": "Button text",
          "description": "Text of the item buttons; an item can have its own.",
          "value": "Explore",
          "condition": {
            "or": [
              {
                "===": [
                  {
                    "var": "itemAction"
                  },
                  "button"
                ]
              },
              {
                "and": [
                  {
                    "!": {
