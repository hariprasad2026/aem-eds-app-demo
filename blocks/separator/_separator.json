{
  "definitions": [
    {
      "title": "Separator",
      "id": "separator",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Separator",
              "model": "separator",
              "key-value": true,
              "accessibilityMode": "decorative",
              "variant": "default",
              "theme": "auto",
              "lineOpacity": "100",
              "maxWidth": "none",
              "alignment": "center",
              "showDesktop": true,
              "showTablet": true,
              "showMobile": true,
              "respectMaxWidth": true,
              "animateOnView": "none",
              "printVisibility": "show"
            }
          }
        }
      }
    }
  ],
