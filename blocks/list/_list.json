{
  "definitions": [
    {
      "title": "List",
      "id": "list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "List",
              "model": "list",
              "filter": "list",
              "key-value": true,
              "titleType": "h2",
              "source": "fixed",
              "orderBy": "manual",
              "sortOrder": "ascending",
              "maxItems": 0,
              "displayAsTeaser": true,
              "cardStyle": "image",
              "imageRatio": "16-9",
              "panelHeight": "portrait",
              "linkItems": true,
              "showImage": true,
              "showEyebrow": true,
              "showTags": true,
              "showDescription": true,
              "showDate": true,
              "dateFormat": "dd-mmm-yy",
              "showCta": true,
              "imageLoading": "lazy",
              "desktopMode": "grid",
              "desktopColumns": 4,
              "tabletMode": "grid",
              "tabletColumns": 4,
              "mobileMode": "grid",
              "mobileColumns": 1,
              "scrollSnap": true,
              "emptyBehavior": "message",
              "analyticsEnabled": true
            }
          }
        }
      }
    },
    {
      "title": "List Item",
      "id": "list-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "List Item",
              "model": "list-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "list",
      "fields": [
        {
          "component": "tab",
          "name": "contentTab",
          "label": "Content"
        },
        {
          "...": "../../models/_card-list.json#/fields/header"
        },
        {
          "component": "tab",
          "name": "sourceTab",
          "label": "Source"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "source",
          "label": "List source",
          "value": "fixed",
          "options": [
            {
              "name": "Child pages",
              "value": "parent"
            },
            {
              "name": "Fixed list",
              "value": "fixed"
            },
            {
              "name": "Tagged pages",
              "value": "tags"
            }
          ],
          "required": true,
          "description": "Child pages of a page, a fixed list of pages and links (add List Items to the block), or pages with tags."
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "parentPath",
          "label": "Parent page",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "parentUseCurrentPage",
          "label": "Use the current page when empty",
          "value": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "directChildrenOnly",
          "label": "Direct children only",
          "value": true,
          "description": "Off: pages down to the Child depth.",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "childDepth",
          "label": "Child depth",
          "value": 2,
          "min": 1,
          "max": 10,
          "description": "Levels below the parent page (1: its children).",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "source"
                  },
                  "parent"
                ]
              },
              {
                "===": [
                  {
                    "var": "directChildrenOnly"
                  },
                  false
                ]
              }
            ]
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "rootPath",
          "label": "Search root",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "tagsUseCurrentPage",
          "label": "Use the current page when empty",
          "value": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "aem-tag",
          "valueType": "string",
          "name": "tags",
          "label": "Tags",
          "multi": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "tagMatch",
          "label": "Match",
          "value": "any",
          "options": [
            {
              "name": "Any of the tags",
              "value": "any"
            },
            {
              "name": "All of the tags",
              "value": "all"
            }
          ],
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "includeDescendants",
          "label": "Include descendant pages",
          "value": true,
          "description": "Off: only the children of the search root.",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "maxDepth",
          "label": "Maximum search depth",
          "value": 0,
          "min": 0,
          "max": 10,
          "description": "0: no limit.",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "source"
                  },
                  "tags"
                ]
              },
              {
                "===": [
                  {
                    "var": "includeDescendants"
                  },
                  true
                ]
              }
            ]
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "orderBy",
          "label": "Order by",
          "value": "manual",
          "options": [
            {
              "name": "Manual (as authored; path order for pages)",
              "value": "manual"
            },
            {
              "name": "Title",
              "value": "title"
            },
            {
              "name": "Last modified",
              "value": "lastModified"
            }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "sortOrder",
          "label": "Sort order",
          "value": "ascending",
          "options": [
            {
              "name": "Ascending",
              "value": "ascending"
            },
            {
              "name": "Descending",
              "value": "descending"
            }
          ],
          "condition": {
            "!==": [
              {
                "var": "orderBy"
              },
              "manual"
            ]
          }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "maxItems",
          "label": "Maximum items",
          "value": 0,
