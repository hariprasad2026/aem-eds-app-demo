          "component": "select",
          "valueType": "string",
          "name": "filterLogic",
          "label": "Filter logic",
          "description": "AND: pages with every selected option. OR: pages with any of them.",
          "value": "and",
          "options": [
            {
              "name": "AND",
              "value": "and"
            },
            {
              "name": "OR",
              "value": "or"
            }
          ]
