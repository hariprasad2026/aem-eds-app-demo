        {
          "component": "tab",
          "name": "contentTab",
          "label": "Content"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title",
          "description": "The label of the tab. The components after this Tab, up to the next Tab, are its content.",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tabId",
          "label": "ID",
          "description": "Links to #ID open this tab (deep link), e.g. overview (lowercase, no spaces). Leave empty for an id from the Tabs ID."
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "activeTab",
          "label": "Active tab",
          "description": "Shows this tab when the page loads (the first tab if no tab is active)."
        },
        {
          "component": "tab",
          "name": "additionalTab",
          "label": "Additional"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "classes_anchor",
          "label": "Anchor ID",
          "description": "A unique ID of the block on the page, starting with anchor-, e.g. anchor-our-services; link to it with #anchor-our-services.",
          "validation": {
            "regExp": "^anchor-[a-z0-9][a-z0-9-]*$",
            "customErrorMsg": "Start with anchor-, then lower-case letters, digits and hyphens."
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_hideblock",
