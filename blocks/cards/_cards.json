{
  "definitions": [
    {
      "title": "Cards",
      "id": "cards",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Cards",
              "filter": "cards"
            }
          }
        }
      }
    },
    {
      "title": "Card",
      "id": "card",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "theme", "selector": "div:nth-child(2) [data-theme]" },
            { "name": "badge", "selector": "div:nth-child(2)>p:first-child" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Card",
              "model": "card"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "card",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Alt"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "theme",
          "value": "default",
          "label": "Card Theme",
          "options": [
            {
              "name": "Default Light",
              "value": "default"
            },
            {
              "name": "Dark Charcoal",
              "value": "dark"
            },
            {
              "name": "Brand Accent Border",
              "value": "highlight"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "badge",
          "label": "Badge / Tag (e.g., FEATURED)"
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards",
      "components": [
        "card"
      ]
    }
  ]
}