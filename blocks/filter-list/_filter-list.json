          "fields": [
            {
              "component": "text",
              "valueType": "string",
              "name": "categoryLabel",
              "label": "Category label",
              "description": "e.g. Industry"
            },
            {
              "component": "aem-tag",
              "valueType": "string",
              "name": "taxonomyRoot",
              "label": "Taxonomy root",
              "description": "e.g. tcs:industry; its tags used by the pages are the options."
            }
          ]
