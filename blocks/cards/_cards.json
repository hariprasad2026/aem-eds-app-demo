        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image alt text",
          "description": "Describes the image for screen readers; empty: decorative."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "eyebrow",
          "label": "Eyebrow",
          "description": "A short label above the title, e.g. Perspective."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title",
          "description": "Statistic cards: the number, e.g. 4bn."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Description",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "subtitle",
          "label": "Label",
          "description": "Statistic cards: the label above the description, e.g. Revenue."
        },
        {
          "component": "aem-tag",
          "valueType": "string",
          "name": "tags",
          "label": "Tags",
          "multi": true
        },
        {
          "component": "date-time",
          "valueType": "date",
