[
  {
    "id": "main",
    "components": [
      "section"
    ]
  },
  {
    "id": "richtext",
    "components": [
      "richtext"
    ],
    "rte": {
      "toolbar": {
        "format": [
          "bold",
          "italic",
          "underline",
          "strike",
          "code_inline",
          "text_color"
        ],
        "alignment": [
          "left",
          "center",
          "right",
          "justify"
        ],
        "direction": [
          "ltr",
          "rtl"
        ],
        "indentation": [
          "indent",
          "outdent"
        ],
        "blocks": [
          "paragraph",
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6",
          "code_block",
          "blockquote"
        ],
        "list": [
          "bullet_list",
          "ordered_list"
        ],
        "insert": [
          "link",
          "unlink",
          "image",
          "table",
          "special_characters"
        ],
        "sr_script": [
          "superscript",
          "subscript"
        ],
        "editor": [
          "removeformat",
          "clean_unsupported_tags",
          "paste_text"
        ],
        "advanced": [
          "classes"
        ],
        "sections": [
          "format",
          "blocks",
          "alignment",
          "direction",
          "list",
          "indentation",
          "insert",
          "sr_script",
          "editor",
          "advanced"
        ]
      },
      "actions": {
        "bold": {
          "tag": "strong"
        },
        "italic": {
          "tag": "em"
        },
        "strike": {
          "tag": "del"
        },
        "image": {
          "wrapInPicture": true
        },
        "table": {
          "showTableProperties": true,
          "showRowProperties": true,
          "showCellProperties": true
        },
        "classes": {
          "label": "Typography style",
          "options": [
            {"value":"rte-font-aptos","label":"Aptos"},
            {"value":"rte-font-arial","label":"Arial"},
            {"value":"rte-font-calibri","label":"Calibri"},
            {"value":"rte-font-cambria","label":"Cambria"},
            {"value":"rte-font-courier-new","label":"Courier New"},
            {"value":"rte-font-consolas","label":"Consolas"},
            {"value":"rte-font-georgia","label":"Georgia"},
            {"value":"rte-font-roboto","label":"Roboto"},
            {"value":"rte-font-roboto-condensed","label":"Roboto Condensed"},
            {"value":"rte-font-times-new-roman","label":"Times New Roman"},
            {"value":"rte-font-tahoma","label":"Tahoma"},
            {"value":"rte-font-trebuchet-ms","label":"Trebuchet MS"},
            {"value":"rte-font-verdana","label":"Verdana"},
            {"value":"rte-google-font-705","label":"Inter"},
            {"value":"rte-google-font-825","label":"Lato"},
            {"value":"rte-google-font-953","label":"Merriweather"},
            {"value":"rte-google-font-998","label":"Montserrat"},
            {"value":"rte-google-font-1278","label":"Nunito"},
            {"value":"rte-google-font-1293","label":"Open Sans"},
            {"value":"rte-google-font-1301","label":"Oswald"},
            {"value":"rte-google-font-1353","label":"Playfair Display"},
            {"value":"rte-google-font-1478","label":"Poppins"},
            {"value":"rte-google-font-1523","label":"Raleway"},
            {"value":"rte-google-font-1721","label":"Source Sans 3"},
            {"value":"rte-google-font-1837","label":"Ubuntu"},
            {"value":"rte-google-font-1899","label":"Work Sans"}
          ]
        }
      }
    }
  },
  {
    "...": "./_section.json#/filters"
  },
  {
    "...": "../blocks/*/_*.json#/filters"
  }
]
