        },
        {
          "component": "text",
          "valueType": "string",
          "name": "componentId",
          "label": "Component ID",
          "description": "Unique on the page (letters, digits, - and _). Used by CSS, analytics, tests and links to #id, so changing it changes those. Empty: generated (separator-1, separator-2, ... in page order).",
          "validation": {
            "regExp": "^[A-Za-z][A-Za-z0-9_-]*$",
            "customErrorMsg": "Start with a letter; use letters, digits, - and _."
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "accessibilityMode",
          "label": "Accessibility mode",
          "value": "decorative",
          "options": [
            {
              "name": "Decorative (visual only)",
              "value": "decorative"
            },
            {
              "name": "Semantic (a thematic break)",
              "value": "semantic"
            }
          ],
          "description": "Semantic: screen readers announce a separator (a change of topic). Decorative: hidden from them (visual division only)."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "accessibleLabel",
          "label": "Accessible label",
          "description": "Optional. Names the break for screen readers, e.g. \"End of the case study\". Most separators need none.",
          "condition": {
            "===": [
              {
                "var": "accessibilityMode"
              },
              "semantic"
            ]
