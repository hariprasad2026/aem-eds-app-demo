{
  "definitions": [
    {
      "title": "Filter List",
      "id": "filter-list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Filter List",
              "model": "filter-list",
              "key-value": true,
              "showResultCount": false,
              "layout": "masonry",
              "cardsPerPage": 9,
              "loadMoreCount": 6,
              "source": "query-index",
              "sortBy": "latest",
              "showAll": true,
              "multiSelect": false,
              "advancedFilter": true,
              "filterLogic": "and",
              "cardStyle": "mixed",
              "enableFeatured": true,
              "featuredRule": "featured",
              "featuredCount": 2,
              "enableHero": false,
              "heroRule": "featured",
              "imageSource": "featured-image",
              "fallbackImage": "thumbnail-image",
              "eyebrowSource": "content-type",
              "titleSource": "title",
              "descriptionSource": "description",
              "tagSource": "tags",
              "urlSource": "path",
              "authorSource": "author"
            }
          }
        }
      }
    }
  ],
  "models": [
